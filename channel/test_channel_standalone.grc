    bus_source: false
    bus_structure: null
    coordinate: [48, 216]
    rotation: 0
    state: enabled
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: Keep the GUI flowgraph at real-time sample rate
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 224]
    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: |-
      """Thin GRC adapter for the project LEO channel hier block."""

      import inspect
      import numpy as np
      from gnuradio import gr
      from channel.leo_channel_model import leo_channel_model


      class blk(gr.basic_block):
          """Expose leo_channel_model parameters inside GNU Radio Companion."""

          def __new__(
              cls,
              samp_rate=2000000,
              t_sys_kelvin=290.0,
              signal_bandwidth_hz=500000.0,
              phase_noise_std=0.002,
              doppler_max_hz=40000.0,
              doppler_profile="linear",
              scintillation_std_db=0.5,
              path_loss_db=0.0,
              doppler_pass_duration_s=10.0,
              scintillation_cutoff_hz=2.0,
              random_seed=24301,
          ):
              """Return the tested reusable GNU Radio hierarchy."""
              if any(frame.function == "extract" for frame in inspect.stack()):
                  return super().__new__(cls)
              return leo_channel_model(
                  samp_rate=samp_rate,
                  t_sys_kelvin=t_sys_kelvin,
                  signal_bandwidth_hz=signal_bandwidth_hz,
                  phase_noise_std=phase_noise_std,
                  doppler_max_hz=doppler_max_hz,
                  doppler_profile=doppler_profile,
                  scintillation_std_db=scintillation_std_db,
                  path_loss_db=path_loss_db,
                  doppler_pass_duration_s=doppler_pass_duration_s,
                  scintillation_cutoff_hz=scintillation_cutoff_hz,
                  random_seed=random_seed,
              )

          def __init__(
              self,
              samp_rate=2000000,
              t_sys_kelvin=290.0,
              signal_bandwidth_hz=500000.0,
              phase_noise_std=0.002,
              doppler_max_hz=40000.0,
              doppler_profile="linear",
              scintillation_std_db=0.5,
              path_loss_db=0.0,
              doppler_pass_duration_s=10.0,
              scintillation_cutoff_hz=2.0,
              random_seed=24301,
          ):
              """Expose the factory signature to GRC."""
              gr.basic_block.__init__(
                  self,
                  "LEO Channel Model",
                  in_sig=[np.complex64],
                  out_sig=[np.complex64],
              )
    affinity: ''
    alias: ''
    comment: Reusable LEO space-channel hier_block2
    doppler_max_hz: doppler_max_hz
    doppler_pass_duration_s: '10.0'
    doppler_profile: '"linear"'
    maxoutbuf: '0'
    minoutbuf: '0'
    path_loss_db: '0.0'
    phase_noise_std: '0.002'
    random_seed: '24301'
    samp_rate: samp_rate
    scintillation_cutoff_hz: '2.0'
    scintillation_std_db: '0.5'
    signal_bandwidth_hz: '500000.0'
    t_sys_kelvin: '290.0'
  states:
    _io_cache: ('LEO Channel Model', 'blk', [('samp_rate', '2000000'), ('t_sys_kelvin', '290.0'), ('signal_bandwidth_hz', '500000.0'), ('phase_noise_std', '0.002'), ('doppler_max_hz', '40000.0'), ('doppler_profile', '"linear"'), ('scintillation_std_db', '0.5'), ('path_loss_db', '0.0'), ('doppler_pass_duration_s', '10.0'), ('scintillation_cutoff_hz', '2.0'), ('random_seed', '24301')], [('0', 'complex', 1)], [('0', 'complex', 1)], 'Expose leo_channel_model parameters inside GNU Radio Companion.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [496, 208]
    rotation: 0
    state: enabled
