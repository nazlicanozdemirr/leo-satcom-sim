    coordinate: [184, 16]
    rotation: 0
    state: enabled
- name: doppler_max_hz
  id: variable
  parameters:
    comment: S-band example Doppler limit
    value: '40000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 16]
    rotation: 0
    state: enabled
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
