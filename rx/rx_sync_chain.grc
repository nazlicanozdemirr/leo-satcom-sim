options:
  parameters:
    author: LEO Satcom Sim
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: TX -> LEO channel -> matched RRC -> Costas -> Gardner timing recovery
    copyright: ''
    description: Phase 3 QPSK synchronization and lock-metric visualization
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: rx_sync_chain
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: LEO RX Synchronization Chain
    window_size: (1300,850)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: import_project
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: |-
      import random
      from config import params
      from gnuradio.filter import firdes
      from channel.leo_channel_model import BOLTZMANN_J_PER_K
      from rx.rx_sync_chain import make_rx_rrc_taps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 16]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: params.samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [256, 16]
    rotation: 0
    state: enabled
- name: sym_rate
  id: variable
  parameters:
    comment: ''
    value: params.sym_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [384, 16]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: params.sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [504, 16]
    rotation: 0
    state: enabled
- name: ebno_db
  id: variable
  parameters:
    comment: Test Eb/No in dB
    value: '6.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [616, 16]
    rotation: 0
    state: enabled
- name: effective_t_sys
  id: variable
  parameters:
    comment: Convert normalized QPSK Eb/No noise power into the channel kTB interface.
    value: (sps / (2.0 * params.ldpc_code_rate * 10.0**(ebno_db / 10.0))) / (BOLTZMANN_J_PER_K * params.signal_bandwidth_hz)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [736, 16]
    rotation: 0
    state: enabled
- name: qpsk_constellation
  id: variable
  parameters:
    comment: ''
    value: digital.constellation_qpsk().base()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 16]
    rotation: 0
    state: enabled
- name: inverse_pre_diff
  id: variable
  parameters:
    comment: Undo the Phase 2 QPSK pre-differential label mapping.
    value: '[list(qpsk_constellation.pre_diff_code()).index(i) for i in range(4)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1112, 16]
    rotation: 0
    state: enabled
- name: rx_rrc_taps
  id: variable
  parameters:
    comment: Same roll-off and tap count as TX, with unit receiver gain.
    value: make_rx_rrc_taps(samp_rate, sym_rate, params.rrc_rolloff, params.rrc_ntaps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 104]
    rotation: 0
    state: enabled
- name: payload_bits
  id: variable
  parameters:
    comment: ''
    value: tuple(random.Random(params.tx_random_seed).choices((0, 1), k=params.ldpc_k_short * 1000))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 104]
    rotation: 0
    state: enabled
- name: blocks_vector_source_x_0
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: Complete 64-bit payload blocks for the TX hierarchy.
    data: payload_bits
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 256]
    rotation: 0
    state: enabled
- name: epy_tx_chain
  id: epy_block
  parameters:
    _source_code: |-
      """GRC adapter for the reusable Phase 2 transmitter."""

      import inspect
      import numpy as np
      from gnuradio import gr
      from tx.tx_chain import tx_chain


      class blk(gr.basic_block):
          """Expose the config-driven TX hierarchy."""

          def __new__(cls):
              """Return the tested reusable GNU Radio hierarchy."""
              if any(frame.function == "extract" for frame in inspect.stack()):
                  return super().__new__(cls)
              return tx_chain()

          def __init__(self):
              """Expose the factory signature to GRC."""
              gr.basic_block.__init__(
                  self,
                  "LEO TX Chain",
                  in_sig=[np.uint8],
                  out_sig=[np.complex64],
              )
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('LEO TX Chain', 'blk', [], [('0', 'byte', 1)], [('0', 'complex', 1)], 'Expose the config-driven TX hierarchy.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [224, 256]
    rotation: 0
    state: enabled
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: GUI-only rate limiter.
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [416, 256]
    rotation: 0
    state: enabled
- name: epy_leo_channel
  id: epy_block
  parameters:
    _source_code: |-
      """GRC adapter for the reusable Phase 1 LEO channel."""

      import inspect
      import numpy as np
      from gnuradio import gr
      from channel.leo_channel_model import leo_channel_model


      class blk(gr.basic_block):
          """Expose the LEO channel with synchronization-test defaults."""

          def __new__(cls, t_sys_kelvin=1.0, doppler_max_hz=8000.0):
              """Return the tested reusable GNU Radio hierarchy."""
              if any(frame.function == "extract" for frame in inspect.stack()):
                  return super().__new__(cls)
              return leo_channel_model(
                  t_sys_kelvin=t_sys_kelvin,
                  doppler_max_hz=doppler_max_hz,
                  phase_noise_std=0.0,
                  scintillation_std_db=0.0,
                  path_loss_db=0.0,
              )

          def __init__(self, t_sys_kelvin=1.0, doppler_max_hz=8000.0):
              """Expose the factory signature to GRC."""
              gr.basic_block.__init__(
                  self,
                  "LEO Channel Model",
                  in_sig=[np.complex64],
                  out_sig=[np.complex64],
              )
    affinity: ''
    alias: ''
    comment: Eb/No=6 dB AWGN plus slowly varying 8 kHz Doppler; no path loss scaling.
    doppler_max_hz: '8000.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    t_sys_kelvin: effective_t_sys
  states:
    _io_cache: ('LEO Channel Model', 'blk', [('t_sys_kelvin', '1.0'), ('doppler_max_hz', '8000.0')], [('0', 'complex', 1)], [('0', 'complex', 1)], 'Expose the LEO channel with synchronization-test defaults.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [608, 256]
    rotation: 0
    state: enabled
- name: fir_filter_xxx_0
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: Matched RRC; retains 4 samples/symbol for Gardner.
    decim: '1'
